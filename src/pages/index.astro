---
import BaseLayout from "../layouts/BaseLayout.astro";
import YouTube from "../components/YouTube.astro";
import ClientsGrid from "../components/ClientsGrid.astro";
import clients from "../content/clients.json";
import showsData from "../content/concerts.json";
import photos from "../content/gallery.json";
import { Image } from "astro:assets";
import { withBase } from "../utils/paths.ts";
import { formatDate } from "../utils/dates";
import { assetImage, isExternal } from "../lib/images";

// Prochaine(s) date(s) ; à défaut, les dernières jouées (le site montre l'activité du groupe plutôt qu'un vide)
const today = new Date().toISOString().slice(0,10);
const allShows = Array.isArray(showsData) ? showsData : [];
const nextShows = allShows
  .filter(s => s.date >= today)
  .sort((a,b) => a.date.localeCompare(b.date))
  .slice(0, 3);
const lastShows = allShows
  .filter(s => s.date < today)
  .sort((a,b) => b.date.localeCompare(a.date))
  .slice(0, 3);

let showsTitle = "Prochains concerts publics";
let showsTag = "#concert";
let shows = nextShows;
if (nextShows.length === 0) {
  showsTitle = "Derniers concerts publics";
  showsTag = "#déjà joué";
  shows = lastShows;
}

// Galerie strip
const galleryStrip = (Array.isArray(photos) ? photos : []).map((p) => {
  const src = String(p.src || "").trim();
  // image locale : optimisée par Astro ; URL externe : affichée telle quelle
  let img = null;
  if (!isExternal(src)) img = assetImage(src);
  return {
    src,
    img,
    alt: p.alt || "Névrosyne 5ch en concert - groupe de rock à Marseille, Aix-en-Provence et en PACA",
  };
});

// Lien infos
const hrefInfos = (s) => {
  if (s?.link && /^(https?:)?\/\//i.test(s.link)) return s.link;
  return withBase(String(s?.link || "concerts/").replace(/^\//, ""));
};
---

<BaseLayout 
  title="Névrosyne 5ch — Groupe de rock approximatif à Marseille, Aix-en-Provence et en PACA" 
  description="Névrosyne 5ch est un groupe de rock approximatif basé entre Marseille et Aix-en-Provence. Reprises, adaptations, compositions originales et concerts live en région PACA."
>

  <!-- HERO -->
  <section class="grid md:grid-cols-2 gap-10 items-center">
    <div class="space-y-6">
      <p class="text-sm tracking-widest uppercase opacity-70">
        Groupe de rock approximatif • Marseille • Aix-en-Provence • PACA
      </p>

      <h1 class="font-display text-6xl md:text-7xl leading-none">
        NÉVROSYNE 5CH
        <span class="sr-only">, groupe de rock approximatif à Marseille, Aix-en-Provence et en région PACA</span>
      </h1>
<!-- 
      <p class="text-lg opacity-85">
        Le seul et l’unique groupe officiel de rock approximatif de l’univers !
      </p>

      <p class="text-lg opacity-85">
        Retrouve toute l’énergie du live à travers des reprises, des adaptations musicales et des compositions originales pour lutter contre la sinistrose.
        Découvre les clips, les dates de concert et l’univers de Névrosyne 5ch, groupe de rock basé entre Marseille et Aix-en-Provence.
      </p> -->

      <p class="text-lg opacity-85">
        Du rock, du vrai !
      </p>

      <p class="text-lg opacity-85">
        Reprises revisitées, adaptations improbables et compos originales :
        Névrosyne 5ch balance un live énergique et décalé, en concert, en festival,
        en mariage ou en événement privé — bref, partout où il faut du son
        pour réveiller les gens.
      </p>      

      <div class="flex flex-wrap gap-3">
        <a href={withBase("concerts/")} class="px-5 py-3 rounded-xl bg-coal-800 hover:bg-coal-700 border border-zinc-700">
          Prochains concerts
        </a>
        <a href={withBase("media/")} class="px-5 py-3 rounded-xl border border-zinc-700 hover:border-acid-400">
          Voir les médias
        </a>
        <a href={withBase("galerie/")} class="px-5 py-3 rounded-xl border border-zinc-700 hover:border-acid-400/80">
          Galerie
        </a>
      </div>

      {nextShows.length > 0 && (
        <div class="mt-2 text-sm rounded-lg border border-zinc-800 bg-coal-800/50 p-3">
          <span class="opacity-70 mr-2">Prochaine date publique :</span>
          <strong>{formatDate(nextShows[0].date)}</strong>
          <span class="opacity-80"> — {nextShows[0].city} • {nextShows[0].venue}</span>
          <a href={withBase("concerts/")} class="ml-3 underline underline-offset-4">Tout voir</a>
        </div>
      )}
    </div>

    <!-- Clip -->
    <div class="relative">
      <YouTube id="bEFTmfcLmTE" title="Névrosyne 5ch - clip officiel du groupe de rock" />
      <div class="pointer-events-none absolute inset-0 ring-1 ring-acid-400/15 rounded-xl"></div>
    </div>
  </section>

  <!-- QUI SOMMES-NOUS -->
  <section class="mt-14">
    <div class="space-y-4">
      <p class="text-sm tracking-widest uppercase opacity-70">Qui sommes-nous ?</p>

      <h2 class="text-2xl md:text-3xl font-bold">
        Névrosyne 5ch, groupe de rock basé entre Marseille et Aix-en-Provence
      </h2>

      <p class="text-lg opacity-85">
        Une seule règle : faire bouger les gens.
        Sur scène, c’est de l’énergie, dans toute la région PACA !
      </p>

      <p class="text-lg opacity-80">
        Approximatif dans le nom, carré sur scène.
      </p>

<!--       <p class="text-lg opacity-85">
        Névrosyne est un groupe de reprises, d’adaptations et de compositions aux influences rock, punk et alternatives,
        basé entre Marseille et Aix-en-Provence, actif sur toute la région PACA.
      </p>

      <p class="opacity-80">
        Sur scène, Névrosyne 5ch te propose un univers énergique, décalé et festif, pensé pour faire bouger le public.
        Le groupe se produit en concert à Marseille, Aix-en-Provence et dans les environs, lors de festivals,
        soirées, événements publics ou privés. Et comme on aime le dire : pour lutter contre la sinistrose,
        prends ta dose de Névrosyne 5ch.
      </p> -->
    </div>
  </section>

  <!-- GALERIE -->
  {galleryStrip.length > 0 && (
    <section class="mt-14">
      <div id="gallery-scroll" class="gallery-scroll">
        {galleryStrip.map((p, i) => (
          <a
            href={withBase("galerie/")}
            key={i}
            class="gallery-item group relative block flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800"
          >
            {p.img ? (
              <Image
                src={p.img}
                alt={p.alt}
                width={840}
                widths={[420, 840]}
                sizes="(min-width: 768px) 420px, 300px"
                format="webp"
                loading="lazy"
                class="w-full h-full object-cover transition-transform group-hover:scale-[1.05]"
              />
            ) : (
              <img
                src={p.src}
                alt={p.alt}
                loading="lazy"
                class="w-full h-full object-cover transition-transform group-hover:scale-[1.05]"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition"></div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CONCERTS -->
  <section class="mt-14">
    <div class="flex items-end justify-between mb-4">
      <h2 class="text-2xl font-bold">{showsTitle}</h2>
      <a href={withBase("concerts/")} class="text-sm opacity-80 hover:opacity-100 underline underline-offset-4">
        Toutes les dates
      </a>
    </div>

    {nextShows.length === 0 && (
      <div class="mb-6 p-4 rounded-xl border border-acid-400/40 bg-coal-800/40">
        <p class="font-semibold">Prochains concerts publics en préparation.</p>
        <p class="mt-1 opacity-85">
          En attendant, Névrosyne joue aussi pour des soirées privées, mariages et événements.
          Tu organises quelque chose ?
          <a class="underline underline-offset-4 text-acid-400 hover:text-acid-500" href={withBase("contact/")}>Parle-nous de ton projet</a>.
        </p>
        <p class="mt-2 text-sm opacity-70">
          Pour être prévenu·e des prochains concerts : <a class="underline underline-offset-4" href="https://facebook.com/nevrosyne" target="_blank" rel="noopener noreferrer">Facebook</a> ou <a class="underline underline-offset-4" href="https://instagram.com/nevrosyne" target="_blank" rel="noopener noreferrer">Instagram</a>.
        </p>
      </div>
    )}

    {shows.length > 0 && (
      <ul class="grid md:grid-cols-3 gap-4">
        {shows.map((s) => (
          <li class="p-4 rounded-xl bg-coal-800/60 border border-zinc-800 flex flex-col gap-2">
            <div class="text-sm opacity-70">{showsTag}</div>
            <div class="text-lg font-semibold">{formatDate(s.date)}</div>
            <div class="opacity-85">{s.city} — {s.venue}</div>
            <div class="mt-auto">
              <a href={hrefInfos(s)} class="inline-block mt-3 px-4 py-2 rounded-lg bg-ink-900 hover:bg-coal-700 border border-zinc-700">
                Infos
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <!-- CLIENTS -->
  {Array.isArray(clients) && clients.length > 0 && (
    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-4">Ils nous ont fait confiance</h2>
      <ClientsGrid items={clients} />
    </section>
  )}

  <!-- CONTACT -->
  <section class="mt-12 text-center">
    <p class="opacity-85 mb-3">
      Tu organises un concert, un événement, un festival ou une soirée ?
    </p>

    <p class="max-w-2xl mx-auto opacity-80 mb-4">
      On joue en live à Marseille, Aix-en-Provence et partout en PACA : salles, festivals, bars, mariages, événements privés, associatifs… Si tu veux du rock (même approximatif), on est là.
    </p>

    <a href={withBase("prestations/")} class="inline-block px-5 py-3 rounded-xl border border-zinc-700 hover:border-acid-400">
      Voir nos prestations
    </a>

    <span class="opacity-60 mx-2">ou</span>

    <a href={withBase("contact/")} class="inline-block px-5 py-3 rounded-xl bg-coal-800 hover:bg-coal-700 border border-zinc-700">
      Écris-nous
    </a>
  </section>

  <!-- Script d’auto-scroll pour la galerie (version Safari-safe) -->
  <script is:raw>
    document.addEventListener("DOMContentLoaded", () => {
      const el = document.getElementById("gallery-scroll");
      if (!el) return;

      const IDLE_MS = 2000;
      const STEP_PX = 1.5;
      const TICK_MS = 16;
      const RESUME_MS = 900;
      const RESPECT_REDUCED = false;

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let auto = null;
      let idle = null;
      let lastUser = 0;

      const canScroll = () => el.scrollWidth > el.clientWidth;
      const startAuto = () => {
        if (auto || !canScroll()) return;
        if (RESPECT_REDUCED && reduced) return;
        el.classList.add("is-auto");
        auto = setInterval(() => {
          const max = el.scrollWidth - el.clientWidth;
          if (max <= 0) return;
          if (el.scrollLeft >= max - STEP_PX) { el.scrollLeft = 0; return; }
          el.scrollLeft += STEP_PX;
        }, TICK_MS);
      };
      const stopAuto = () => { if (auto) { clearInterval(auto); auto = null; } el.classList.remove("is-auto"); };
      const scheduleAuto = () => { if (idle) clearTimeout(idle); idle = setTimeout(startAuto, IDLE_MS); };
      const userInteracted = () => {
        lastUser = Date.now();
        stopAuto();
        if (idle) clearTimeout(idle);
        idle = setTimeout(() => { if (Date.now() - lastUser >= RESUME_MS) startAuto(); }, IDLE_MS);
      };

      el.addEventListener("wheel", (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); el.scrollLeft += e.deltaY; }
        userInteracted();
      }, { passive: false });
      ["touchstart","touchmove","pointerdown","pointermove","keydown"].forEach(evt => {
        el.addEventListener(evt, userInteracted, { passive: true });
      });
      document.addEventListener("visibilitychange", () => { if (document.hidden) { stopAuto(); } else { scheduleAuto(); } });
      scheduleAuto();
    });
  </script>

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    "name": "Névrosyne 5ch",
    "url": new URL(withBase(""), Astro.site).href,
    "logo": new URL(withBase("favicon-512.png"), Astro.site).href,
    "genre": ["Rock", "Punk", "Rock alternatif"],
    "description": "Névrosyne 5ch est un groupe de reprises, d’adaptations et de compositions originales basé entre Marseille et Aix-en-Provence, actif en région PACA.",
    "areaServed": "Provence-Alpes-Côte d'Azur",
    "foundingLocation": {
      "@type": "Place",
      "name": "Marseille"
    },
    "sameAs": [
      "https://www.facebook.com/Nevrosyne/",
      "https://www.youtube.com/@Nevrosyne5CH"
    ]
  })} />

</BaseLayout>