---
import { getImage } from "astro:assets";
import { assetImage } from "../lib/images";
const {
  title = "Nevrosyne 5ch — Site officiel",
  description = "Groupe de rock Nevrosyne : concerts, evenements et contact.",
  image = "logo.png",                                  // chemin relatif à src/assets
  noindex = false,                                     // pages à exclure des moteurs (404, confirmation...)
} = Astro.props;

// Les robots et les réseaux sociaux exigent des URL absolues :
// on part de `site` (astro.config.mjs) et du chemin de la page, qui contient déjà la base.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// PNG (et non WebP) : tous les réseaux sociaux ne lisent pas le WebP en aperçu
const ogImage = await getImage({ src: assetImage(image), width: 1200, format: "png" });
const imageUrl = new URL(ogImage.src, Astro.site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Nevrosyne 5ch" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
